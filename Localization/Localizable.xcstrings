        }
      }
    },
    "After the ZIP is created successfully, the original file or folder and all its contents are permanently deleted. This cannot be undone. Following actions apply to the ZIP." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem das ZIP erstellt wurde, werden die Originaldatei bzw. der Originalordner samt Inhalt endgültig gelöscht. Dies kann nicht widerrufen werden. Nachfolgende Aktionen gelten für das ZIP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez creado el ZIP, el archivo o la carpeta original y todo su contenido se eliminan permanentemente. Esto no se puede deshacer. Las acciones siguientes se aplican al ZIP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois le ZIP créé, le fichier ou dossier d’origine et tout son contenu sont supprimés définitivement. Cette opération est irréversible. Les actions suivantes s’appliquent au ZIP."
          }
        }
      }
    },
