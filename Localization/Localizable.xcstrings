      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge {kind}, {extension}, {year}, {month}, {day}, {hour}, {minute} oder {quarter} hinzu, um in Ordner zu sortieren, z. B. …/Sortiert/{kind}/{year}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
