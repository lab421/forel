    "Free" : {
      "shouldTranslate" : false
    },
    "Free forever: 2 watched folders and 300 processed files per month, with unlimited rules and actions. No trial." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für immer kostenlos: 2 überwachte Ordner und 300 verarbeitete Dateien pro Monat, mit unbegrenzten Regeln und Aktionen. Keine Testphase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis para siempre: 2 carpetas vigiladas y 300 archivos procesados al mes, con reglas y acciones ilimitadas. Sin periodo de prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pour toujours : 2 dossiers surveillés et 300 fichiers traités par mois, avec règles et actions illimitées. Sans période d’essai."
          }
        }
      }
    },
    "Free includes 2 watched folders. With Pro, organize your projects, invoices, and downloads with unlimited folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free umfasst 2 überwachte Ordner. Mit Pro organisierst du Projekte, Rechnungen und Downloads mit unbegrenzt vielen Ordnern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free incluye 2 carpetas vigiladas. Con Pro, organiza tus proyectos, facturas y descargas con carpetas ilimitadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free comprend 2 dossiers surveillés. Avec Pro, organisez vos projets, factures et téléchargements avec un nombre illimité de dossiers."
          }
        }
      }
    },
    "Free includes 300 processed files per calendar month, shared across all folders. Activate Pro for unlimited processing, or resume next month. Dry Run remains available and your remaining files stay in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free umfasst 300 verarbeitete Dateien pro Kalendermonat, geteilt über alle Ordner. Aktiviere Pro für unbegrenzte Verarbeitung oder mach nächsten Monat weiter. Der Testlauf bleibt verfügbar und deine übrigen Dateien bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free incluye 300 archivos procesados por mes natural, compartidos entre todas las carpetas. Activa Pro para un procesamiento ilimitado o continúa el mes que viene. La simulación sigue disponible y tus archivos restantes se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free comprend 300 fichiers traités par mois civil, partagés entre tous les dossiers. Activez Pro pour un traitement illimité, ou reprenez le mois prochain. La simulation reste disponible et vos fichiers restants ne bougent pas."
          }
        }
      }
    },
    "Free stays free. Pro is a paid license, with no trial." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free bleibt kostenlos. Pro ist eine kostenpflichtige Lizenz ohne Testphase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free sigue siendo gratis. Pro es una licencia de pago, sin periodo de prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free reste gratuit. Pro est une licence payante, sans période d’essai."
          }
        }
      }
    },
