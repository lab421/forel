        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel réessaiera une fois qu’il sera connecté, si la surveillance est toujours active."
          }
        }
      }
    },
    "Forel will try again when they're connected, if watching is still on." : {
