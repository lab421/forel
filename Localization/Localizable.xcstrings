    "The destination folder can't be reached or written to right now. Check that the disk or network share is connected and that Forel is allowed to access it." : {
      "comment" : "Warning in Dry Run",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Zielordner kann gerade nicht zugegriffen oder geschrieben werden. Prüfe, ob das Laufwerk oder die Netzwerkfreigabe verbunden ist und Forel darauf zugreifen darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo no se puede acceder a la carpeta de destino ni escribir en ella. Comprueba que el disco o el recurso compartido de red esté conectado y que Forel tenga permiso para acceder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de destination est inaccessible ou protégé en écriture pour l’instant. Vérifiez que le disque ou le partage réseau est connecté et que Forel est autorisé à y accéder."
          }
        }
      }
    },
