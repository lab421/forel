    },
    "Forel Free has reached its limit of 300 processed files this month. Processing resumes next month, or activate Pro for unlimited files. Your remaining files stay in place." : {
      "comment" : "Forel Free limit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel Free hat das Limit von 300 verarbeiteten Dateien in diesem Monat erreicht. Die Verarbeitung wird nächsten Monat fortgesetzt, oder aktiviere Pro für unbegrenzt viele Dateien. Deine übrigen Dateien bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel Free ha alcanzado su límite de 300 archivos procesados este mes. El procesamiento se reanudará el mes que viene, o activa Pro para archivos ilimitados. Tus archivos restantes se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel Free a atteint sa limite de 300 fichiers traités ce mois-ci. Le traitement reprendra le mois prochain, ou activez Pro pour un nombre illimité de fichiers. Vos fichiers restants ne bougent pas."
          }
        }
      }
    },
    "Forel Free supports 2 watched folders. Remove a folder or activate Pro to add another." : {
      "comment" : "Forel Free limit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel Free unterstützt 2 überwachte Ordner. Entferne einen Ordner oder aktiviere Pro, um einen weiteren hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel Free admite 2 carpetas vigiladas. Quita una carpeta o activa Pro para añadir otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel Free prend en charge 2 dossiers surveillés. Retirez un dossier ou activez Pro pour en ajouter un autre."
          }
        }
      }
    },
    "Forel Pro" : {
      "shouldTranslate" : false
