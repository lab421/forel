        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel cambiará a %@ cuando se vuelva a abrir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel wechselt beim nächsten Start zu %@."
          }
        }
      }
    },
    "Forel will try again when it's connected, if watching is still on." : {
      "comment" : "Notification when a destination disk or share isn’t connected",
      "localizations" : {
        "de" : {
          "stringUnit" : {
