    "Matches every file in scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt auf alle Dateien im Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con todos los archivos del ámbito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond à tous les fichiers concernés."
          }
        }
      }
    },
    "Matches every value of the file's download metadata, as Finder shows it in Get Info under Where from. Availability depends on the app that created the file." : {
      "comment" : "Help shown next to a rule condition",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt auf jeden Wert der Download-Metadaten der Datei, wie der Finder sie unter „Informationen“ bei „Woher“ anzeigt. Die Verfügbarkeit hängt von der App ab, die die Datei erstellt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con cada valor de los metadatos de descarga del archivo, tal como el Finder los muestra en Obtener información, en Procedencia. Su disponibilidad depende de la app que creó el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond à chaque valeur des métadonnées de téléchargement du fichier, telles que le Finder les affiche dans Lire les informations sous Provenance. Leur disponibilité dépend de l’app qui a créé le fichier."
          }
        }
      }
    },
    "Matches only http and https addresses from the file's download metadata. For other sources, such as blob: addresses, use Raw where-from metadata." : {
      "comment" : "Help shown next to a rule condition",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt nur auf http- und https-Adressen aus den Download-Metadaten der Datei. Für andere Quellen wie blob:-Adressen verwende „Rohe Woher-Metadaten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo coincide con las direcciones http y https de los metadatos de descarga del archivo. Para otras fuentes, como las direcciones blob:, usa Metadatos de procedencia sin procesar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond uniquement aux adresses http et https des métadonnées de téléchargement du fichier. Pour les autres sources, comme les adresses blob:, utilisez Métadonnées de provenance brutes."
          }
        }
      }
    },
    "Matches text from plain files, PDFs, Word documents, and images via OCR when available." : {
      "comment" : "Help shown next to a rule condition",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt auf Text aus Textdateien, PDFs, Word-Dokumenten und Bildern per OCR, sofern verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con el texto de archivos de texto, PDF, documentos de Word e imágenes mediante OCR cuando está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond au texte des fichiers texte, des PDF, des documents Word et des images par OCR lorsqu’il est disponible."
          }
        }
      }
    },
    "Matches the Finder comment shown in Get Info. Files without a comment are treated as having an empty comment." : {
      "comment" : "Help shown next to a rule condition",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt auf den Finder-Kommentar, der unter „Informationen“ angezeigt wird. Dateien ohne Kommentar werden wie mit leerem Kommentar behandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con el comentario del Finder que aparece en Obtener información. Los archivos sin comentario se tratan como si tuvieran un comentario vacío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond au commentaire Finder affiché dans Lire les informations. Les fichiers sans commentaire sont traités comme ayant un commentaire vide."
          }
        }
      }
    },
    "Matches the Finder tags shown in Get Info, not other file metadata." : {
      "comment" : "Help shown next to a rule condition",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt auf die Finder-Tags, die unter „Informationen“ angezeigt werden, nicht auf andere Metadaten der Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con las etiquetas del Finder que aparecen en Obtener información, no con otros metadatos del archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond aux tags Finder affichés dans Lire les informations, pas aux autres métadonnées du fichier."
          }
        }
      }
    },
    "Matches the Locked checkbox in Finder's Get Info window, independently of read and write permissions." : {
      "comment" : "Help shown next to a rule condition",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
