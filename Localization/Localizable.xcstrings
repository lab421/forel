          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con la casilla Bloqueado de la ventana Obtener información del Finder, con independencia de los permisos de lectura y escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
