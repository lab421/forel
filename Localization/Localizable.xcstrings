    "Forel is running from the installer disk image. Drag Forel into your Applications folder, then open it from there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel wird vom Installations-Image ausgeführt. Ziehe Forel in deinen Programme-Ordner und öffne es von dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel se está ejecutando desde la imagen de disco de instalación. Arrastra Forel a tu carpeta Aplicaciones y ábrelo desde allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel s’exécute depuis l’image disque d’installation. Faites glisser Forel dans votre dossier Applications, puis ouvrez-le depuis cet emplacement."
          }
        }
      }
    },
    "Forel is still processing a file event in this watched folder. Try again once it finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel verarbeitet noch ein Dateiereignis in diesem überwachten Ordner. Versuche es erneut, sobald es fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel aún está procesando un evento de archivo en esta carpeta vigilada. Inténtalo de nuevo cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel traite encore un événement de fichier dans ce dossier surveillé. Réessayez une fois qu’il aura terminé."
          }
        }
      }
    },
    "Forel switches to %@ when it relaunches." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel passera en %@ à son prochain lancement."
          }
