{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown when Forel first asks to control Music or TV.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel uses automation to add files to the Music and TV libraries as part of automated rules."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel utilise l’automatisation pour ajouter des fichiers aux bibliothèques Musique et TV dans le cadre de règles automatisées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel usa la automatización para añadir archivos a las bibliotecas de Música y TV como parte de las reglas automatizadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel verwendet Automation, um im Rahmen automatisierter Regeln Dateien zu den Mediatheken von Musik und TV hinzuzufügen."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Shown when Forel first asks for access to the Photos library.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel can import images and videos into your Photos library as part of automated rules."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel peut importer des images et des vidéos dans votre photothèque Photos dans le cadre de règles automatisées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel puede importar imágenes y vídeos a tu fototeca de Fotos como parte de las reglas automatizadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forel kann im Rahmen automatisierter Regeln Bilder und Videos in deine Fotos-Mediathek importieren."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
